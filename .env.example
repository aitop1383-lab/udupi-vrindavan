# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
APP_URL="MY_APP_URL"

# Blog Database Configuration (Vite Env Variables)
# mode can be 'google_sheets', 'supabase', or 'both'
VITE_BLOG_MODE="both"

# 1. Supabase Settings
VITE_SUPABASE_URL="https://your-project-ref.supabase.co"
VITE_SUPABASE_ANON_KEY="your-anon-public-api-key"

# 2. Google Sheets Web App URL (legacy / blog)
VITE_GOOGLE_SHEETS_URL="https://script.google.com/macros/s/XXXXXX/exec"

# 3. CRM Form + Table Booking Apps Script URL
VITE_CRM_SCRIPT_URL="https://script.google.com/macros/s/XXXXXX/exec"
