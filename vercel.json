{
  "redirects": [
    {
      "source": "/(booking|bookings|book|reservation|reservations|table-booking)",
      "destination": "https://order.udupivrindavan.com",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/api/wp/:path*",
      "destination": "http://d7v.021.myftpupload.com/wp-json/wp/v2/:path*"
